{
  "name": "token-sprite",
  "private": true,
  "version": "0.3.1",
  "description": "一只会从本地 AI 编程 token 用量中成长的桌面小精灵",
  "author": "shiyubao78",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "node scripts/sync.mjs",
    "electron": "electron .",
    "desktop": "cross-env TS_DEV_URL=http://localhost:5173 electron .",
    "pack": "npm run build && electron-builder --mac dir --universal",
    "pack:mac:release": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:update-artifacts": "node scripts/verify-update-artifacts.mjs",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.tokensprite.app",
    "productName": "Token小精灵",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "afterSign": "scripts/notarize.cjs",
    "files": [
      "electron/**",
      "!electron/**/*.test.js",
      "build/icon.png",
      "build/tray-icon.png",
      "dist/**",
      "scripts/usage.mjs",
      "package.json"
    ],
    "mac": {
      "artifactName": "${name}-${version}-${arch}-${os}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "portable"
        },
        {
          "target": "nsis"
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shiyubao78",
        "repo": "token-sprite"
      }
    ]
  }
}
